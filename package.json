{
  "name": "ngrx-traits",
  "version": "0.0.0-development",
  "license": "MIT",
  "scripts": {
    "postinstall": "node ./decorate-angular-cli.js",
    "nx": "nx",
    "ng": "ng",
    "start": "nx run-many --target=serve --projects=example-api,example-app --parallel",
    "start:api": "nx serve example-api",
    "start:docs": "pnpm --dir apps/docs start",
    "build:ssr": "nx build example-app",
    "serve:ssr": "node dist/apps/example-app/server/server.mjs",
    "test": "nx affected:test",
    "build": "nx run-many --target=build --projects=ngrx-traits-signals,ngrx-traits-core,ngrx-traits-common,example-app,example-api",
    "build:libs": "nx run-many --target=build --projects=ngrx-traits-signals,ngrx-traits-core,ngrx-traits-common",
    "build:apps": "nx run-many --target=build --projects=example-app,example-api",
    "test-all": "nx run-many --target=test --projects=ngrx-traits-signals,ngrx-traits-core,ngrx-traits-common,example-app --skip-nx-cache --no-cloud",
    "test:libs": "nx run-many --target=test --projects=ngrx-traits-signals,ngrx-traits-core,ngrx-traits-common --skip-nx-cache --no-cloud",
    "test:apps": "nx run-many --target=test --projects=example-app --skip-nx-cache --no-cloud",
    "typecheck": "nx run-many --all --target=typecheck",
    "lint": "nx lint ngrx-traits",
    "e2e": "nx e2e",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "semantic-release": "semantic-release --debug",
    "commit": "git-cz",
    "acp": "git add . && pnpm run commit && git push",
    "api-docs": "nx run-many --all --target=api-docs",
    "install:libs": "pnpm install --frozen-lockfile --filter=\"!./apps/*\"",
    "install:docs": "pnpm --dir apps/docs install --frozen-lockfile",
    "build:docs": "pnpm --dir apps/docs build",
    "test:docs": "pnpm --dir apps/docs test"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/ssr": "catalog:",
    "@ngrx/effects": "catalog:",
    "@ngrx/entity": "catalog:",
    "@ngrx/operators": "catalog:",
    "@ngrx/signals": "catalog:",
    "@ngrx/store": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "zone.js": "catalog:"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular-devkit/build-angular": "catalog:",
    "@angular-devkit/core": "catalog:",
    "@angular-devkit/schematics": "catalog:",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/language-service": "catalog:",
    "@angular/router": "catalog:",
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.0",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-proposal-decorators": "^7.17.12",
    "@babel/plugin-proposal-object-rest-spread": "^7.17.12",
    "@babel/preset-env": "^7.18.0",
    "@babel/preset-typescript": "^7.17.12",
    "@ngneat/spectator": "^22.1.0",
    "@nx/angular": "23.1.1",
    "@nx/esbuild": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@schematics/angular": "catalog:",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "@trivago/prettier-plugin-sort-imports": "^4.2.1",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "cz-conventional-changelog": "^3.0.1",
    "dotenv": "10.0.0",
    "esbuild": "^0.27.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "glob": "^11.0.0",
    "jest-marbles": "3.0.6",
    "jsdoc-babel": "^0.5.0",
    "jsdoc-to-markdown": "^9.1.3",
    "jsdom": "^27.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "22.1.1",
    "ngxtension": "^7.3.0",
    "nx": "23.1.1",
    "prettier": "3.2.5",
    "semantic-release": "^25.0.2",
    "ts-mockito": "^2.6.1",
    "ts-node": "10.9.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielguerrero/ngrx-traits.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
