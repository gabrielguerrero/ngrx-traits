auto-install-peers=true
strict-peer-dependencies=false
minimum-release-age=4320

# @angular/build generates its dev-server SSR entry in .angular/vite-root at the
# workspace root, so Node resolves the app's packages from the ROOT node_modules
# rather than apps/example-app/node_modules. Publicly hoisting these keeps them
# declared in the app manifest (out of the root package.json) while staying
# resolvable from where the generated code lives.
public-hoist-pattern[]=@angular/*
public-hoist-pattern[]=@ngrx/*
public-hoist-pattern[]=@js-temporal/*
