{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/docs",
        "command": "pnpm build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/docs",
        "command": "pnpm start"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "cwd": "apps/docs",
        "command": "pnpm test"
      }
    }
  },
  "tags": [],
  "sourceRoot": "apps/docs/src"
}
